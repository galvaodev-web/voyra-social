NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TRAVEL_URL=http://localhost:3001
# Set on BOTH products only after deploying to HTTPS subdomains.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# Keep false until transcoding, metadata stripping, duration checks and poster generation exist.
NEXT_PUBLIC_VIDEO_UPLOAD_ENABLED=false
# Optional Travel API, implementing the documented user-token contract.
VOYRA_TRAVEL_API_URL=
OPENAI_API_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional server-side error tracking. Do not expose DSNs containing secrets.
SENTRY_DSN=
# Server only: required for validated media uploads. Never use a NEXT_PUBLIC prefix.
SUPABASE_SERVICE_ROLE_KEY=
